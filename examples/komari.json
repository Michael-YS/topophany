{
  "schema": 1,
  "project": "komari-resources",
  "nodes": [
    {"id": "collector", "name": "Collector", "kind": "host"},
    {"id": "server-1", "name": "Komari server", "kind": "host", "resource_checks": ["server-1-resources"]}
  ],
  "endpoints": [],
  "services": [],
  "observers": [
    {"id": "komari-reader", "node": "collector", "context": "reads the Komari server from this observer"}
  ],
  "paths": [],
  "sources": [
    {
      "id": "komari-server",
      "name": "Komari Monitor",
      "adapter": "komari",
      "observer": "komari-reader",
      "target": "https://komari.example.com",
      "credential_env": "TOPO_KOMARI_API_KEY",
      "interval_seconds": 30,
      "timeout_seconds": 8,
      "stale_seconds": 90,
      "max_response_bytes": 1048576,
      "max_pages": 1,
      "max_objects": 1,
      "max_report_bytes": 65536,
      "notes": "Replace target and external.object with the server base URL and client UUID. Supply a raw administrator API key in TOPO_KOMARI_API_KEY; omit credential_env for public nodes."
    }
  ],
  "checks": [
    {
      "id": "server-1-resources",
      "name": "Komari server resources",
      "observer": "komari-reader",
      "kind": "external",
      "external": {
        "source": "komari-server",
        "object": "12345678-1234-4234-8234-123456789abc",
        "report": "resource",
        "node": "server-1",
        "max_age_seconds": 90,
        "primary_disk": "aggregate",
        "assertions": {"cpu_percent_max": 90, "memory_percent_max": 90, "disk_percent_max": 85}
      }
    }
  ]
}
