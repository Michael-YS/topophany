[Unit]
Description=Topophany collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=topophany
Group=topophany
StateDirectory=topophany
WorkingDirectory=/var/lib/topophany
ExecStart=/usr/local/bin/topo serve --config /etc/topophany/topology.json --auth /etc/topophany/auth.json --data /var/lib/topophany/collector --instance collector-a --listen 0.0.0.0:7447 --tls-cert /etc/topophany/server.pem --tls-key /etc/topophany/server-key.pem
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/topophany
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
